# Copy this file to .env and fill in your values. Never commit .env.

# --- LLM (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-calling model on OpenRouter. Cheaper alternative: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# --- Robinhood Chain (mainnet, chain ID 4663) ---
# Comma-separated list, tried in order (fallback). Leave empty to use the built-in defaults:
# https://robinhood-rpc.publicnode.com, https://robinhood.drpc.org, https://rpc.mainnet.chain.robinhood.com
RPC_URL=
# Archive-capable RPC for ledger sync (historical balances). Empty = https://robinhood.drpc.org
ARCHIVE_RPC_URL=

# --- Local data (encrypted keystore + SQLite ledger) ---
# Leave empty for the default: ~/.grand-transfer-agent
DATA_DIR=

# --- Safety limits (ETH, decimal strings) ---
MAX_TX_ETH=0.05
MAX_DAILY_ETH=0.2

# --- Public web app (leave unset to run locally on 127.0.0.1) ---
# GTA_PUBLIC_MODE=true                 data per wallet, AI quotas on
# GTA_PUBLIC_ORIGIN=https://gta.example.com
# GTA_TRUST_PROXY=true                 behind Caddy/nginx: read the client IP from X-Forwarded-For
# AI_MESSAGES_PER_WALLET_DAY=30        0 = unlimited
# AI_DAILY_BUDGET_USD=3                0 = unlimited
