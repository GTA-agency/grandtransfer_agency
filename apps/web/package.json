{
  "name": "@gta/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web app for Grand Transfer Agent (Next.js App Router, local only).",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4663",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4663",
    "typecheck": "tsc -p tsconfig.json",
    "cf:build": "GTA_PUBLIC_ORIGIN=https://grandtransfer.agency opennextjs-cloudflare build",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@gta/core": "workspace:*",
    "@tanstack/react-query": "5.108.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "viem": "^2.58.0",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@opennextjs/cloudflare": "1.20.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "playwright-core": "^1.65.1",
    "wrangler": "4.162.0"
  }
}
